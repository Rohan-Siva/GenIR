{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "compile-less": "find src -name \"*.less\" -exec sh -c 'npx lessc \"$0\" \"${0%.less}.css\"' {} \\;",
    "watch-less": "less-watch-compiler src src less css --source-map",
    "dev": "concurrently \"npm run watch-less\" \"vite\" \"npm run start:backend\"",
    "start:backend": "uvicorn server:app --reload",
    "build": "npm run compile-less && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.21.1",
    "jwt-decode": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "less": "^4.2.2",
    "less-watch-compiler": "^1.16.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0"
  }
}